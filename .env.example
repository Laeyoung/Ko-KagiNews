# Gemini API key — REQUIRED for cron/scripts only (server runtime does not need it)
GEMINI_API_KEY=your-key-here
# Model id override (re-confirm current id + pricing at implementation time)
GEMINI_MODEL=gemini-3.1-flash-lite
# Sidecar dir shared by cron + server. 프로덕션에서는 절대 경로 필수:
# TRANSLATIONS_DIR=/opt/ko-kaginews/data/translations
TRANSLATIONS_DIR=./data/translations
# Upstream override (tests only)
KITE_API_BASE=https://kite.kagi.com/api
# Wait-mode poll cadence in ms (spec §4.3 step 1; unset/invalid → 30000)
WAIT_POLL_INTERVAL_MS=30000
# Serving kill-switch: 'false' forces English-only regardless of sidecars
TRANSLATIONS_ENABLED=true

# --- Microsoft Clarity (heatmaps + session recordings) ---
# ⚠️ 동의 게이트와 개인정보 처리방침 고지가 배포되기 전에는 켜지 마세요.
#    세션 리코딩은 GDPR Art.6·ePrivacy 5(3), PIPA Art.15/22·28-8(국외이전)·30
#    대상입니다. 현재 레포에 동의 UI 가 없습니다 (CLAUDE.md "Analytics" 참조).
# Build-time flag, client-visible. 'true' 일 때만 태그가 로드됩니다.
# 프로덕션 환경에만 설정하세요 — preview/CI 빌드도 dev 가 아니므로, 이 플래그가
# 유일한 게이트입니다. 미설정 시 Clarity 는 아예 로드되지 않습니다.
# 런타임 킬스위치가 아닙니다 (위 TRANSLATIONS_ENABLED 와 다름): 변수를 지워도
# 재배포 전까지 태그는 계속 로드됩니다. 즉시 중단은 플래그 도입 이전 배포로 rollback.
# VITE_CLARITY_ENABLED=true
# 프로젝트 ID 오버라이드 (미설정 시 src/lib/client/clarity.ts 의 기본값 사용).
# 포크/셀프호스트는 반드시 자기 ID 로 바꾸세요.
# VITE_CLARITY_PROJECT_ID=your-clarity-project-id
